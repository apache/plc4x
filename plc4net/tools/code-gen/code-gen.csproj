<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AssemblyName>plc4net-code-gen</AssemblyName>
    <Title>PLC4Net: Code Generation</Title>
    <RootNamespace>org.apache.plc4net.tools.codegen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CS3021: ANTLR emits [CLSCompliant(false)] on every generated lexer, parser
      and listener, but this assembly declared no [assembly: CLSCompliant] at
      all, which made every one of those attributes redundant and raised one
      warning per generated type. Declaring the assembly non-CLS-compliant
      (false) states exactly what the generated code already claims and removes
      the redundancy at its source: no generated file is hand-edited and no
      diagnostic is suppressed.
    -->
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

</Project>

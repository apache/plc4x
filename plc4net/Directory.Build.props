<Project>

  <!--
    Properties shared by every PLC4Net project. Keeping them here means a
    framework or version bump is a one-line change instead of a sweep over
    every .csproj.
  -->
  <PropertyGroup>
    <!--
      net8.0 (LTS) replaces the previous net452 target. .NET Framework 4.5.2
      went out of support in April 2022 and cannot be built on the Linux and
      macOS CI runners, which is what kept PLC4Net off the CI matrix.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <!-- The module builds warning-clean today; keep it that way in CI so a
         later change cannot quietly regress it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>org.apache.plc4net</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Apache PLC4X</Authors>
    <Copyright>The Apache Software Foundation</Copyright>
    <PackageProjectUrl>https://plc4x.apache.org</PackageProjectUrl>
    <!-- PackageLicenseUrl is deprecated (NU5125); the SPDX expression replaces it. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Overridden by the Maven build via -p:Version=${project.version}. -->
    <Version>1.0.0-SNAPSHOT</Version>
  </PropertyGroup>

</Project>

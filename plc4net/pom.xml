<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">

  <parent>
    <groupId>org.apache.plc4x</groupId>
    <artifactId>plc4x-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>plc4net</artifactId>
  <packaging>pom</packaging>

  <name>PLC4Net</name>
  <description>Implementation of the protocol adapters for usage as .Net module.</description>

  <!-- Disabled for now as C# support is currently not installed in Apache SonarQube -->
  <!--properties>
    <sonar.language>c#</sonar.language>
  </properties-->

  <properties>
    <project.build.outputTimestamp>2025-08-02T13:55:11Z</project.build.outputTimestamp>
  </properties>

  <build>
    <plugins>
      <!--
        A Visual Studio solution file cannot carry a license header: its
        "Format Version" marker is positional and has to appear within the first
        two lines, so anything prepended above it makes the file unreadable to
        the .Net tooling.

        The ANTLR side-car files emitted next to the generated parsers cannot
        carry one either. A ".tokens" file is a bare "name=value" table with no
        comment syntax at all, and a ".interp" file is a positional dump of the
        serialized ATN, so any line prepended to either one is read as data and
        corrupts the grammar. Both are regenerated from the ".g4" sources, which
        do carry the header.
      -->
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <inputExcludes combine.children="append">
            <inputExclude>**/*.sln</inputExclude>
            <inputExclude>**/generated/*.interp</inputExclude>
            <inputExclude>**/generated/*.tokens</inputExclude>
          </inputExcludes>
        </configuration>
      </plugin>

      <!--
        The reactor bridge: `./mvnw -Pwith-dotnet install` shells out to the
        .NET SDK so the release build still covers this module. Day-to-day
        development needs none of this - `dotnet build` / `dotnet test` on
        plc4net.sln is the whole story, and CI (.github/workflows/dotnet-platform.yml)
        runs no JDK and no Maven.

        The protocol test-suite XML (ParserSerializerTestsuite.xml) used to be
        unpacked here from the plc4x-protocols-knxnetip test-jar; it is now
        checked in under test/knxnetip-test/resources/, so neither the unpack
        step nor the test-jar dependency is needed.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>dotnet-build</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>dotnet</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>build</argument>
                <argument>plc4net.sln</argument>
                <argument>--configuration=Debug</argument>
                <argument>--output=${project.build.directory}/build</argument>
                <argument>-p:Version=${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>dotnet</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>test</argument>
                <argument>plc4net.sln</argument>
                <argument>--configuration=Debug</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Regenerate the checked-in driver models from the mspec descriptions.
      This used to run the Java plc4x-maven-plugin with languageName=C#; that
      generator only ever emitted data classes (its io-template is
      un-migrated Java and unregistered). It is replaced by the pure-.NET
      generator under tools/code-gen: no JDK, no freemarker. Run it directly
      with `dotnet run` on that project (protocol, mspec path, output dir,
      namespace); this profile is only the reactor wrapper:

        ./mvnw -P'with-dotnet,update-generated-code' -pl :plc4net install

      knxnetip is not regenerated yet: its mspec spans three files including
      the machine-generated knx-master-data.mspec, and dataIo emission is
      still open (see docs/design.md).
    -->
    <profile>
      <id>update-generated-code</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-modbus</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>dotnet</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>run</argument>
                    <argument>--project</argument>
                    <argument>tools/code-gen</argument>
                    <argument>--configuration</argument>
                    <argument>Release</argument>
                    <argument>--</argument>
                    <argument>modbus</argument>
                    <argument>${project.basedir}/../protocols/modbus/src/main/resources/protocols/modbus/modbus.mspec</argument>
                    <argument>${project.basedir}/drivers/modbus/src/drivers/modbus/readwrite</argument>
                    <argument>org.apache.plc4net.drivers.modbus.readwrite</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>generate-s7</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>dotnet</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>run</argument>
                    <argument>--project</argument>
                    <argument>tools/code-gen</argument>
                    <argument>--configuration</argument>
                    <argument>Release</argument>
                    <argument>--</argument>
                    <argument>s7</argument>
                    <argument>${project.basedir}/../protocols/s7/src/main/resources/protocols/s7/s7.mspec</argument>
                    <argument>${project.basedir}/drivers/s7/src/drivers/s7/readwrite</argument>
                    <argument>org.apache.plc4net.drivers.s7.readwrite</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>